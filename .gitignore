# =========================================
# Node.js & React Frontend (Vite)
# =========================================
node_modules/
dist/
dist-ssr/
*.local

# npm/yarn/pnpm diagnostic logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================================
# Rust & Tauri Backend
# =========================================
src-tauri/target/
# Note: We do NOT ignore src-tauri/Cargo.lock. It should be committed to ensure reproducible builds.

# =========================================
# AI Models & Vector Database (CRITICAL)
# =========================================
# Ignore all downloaded LLM weights
*.gguf
*.bin
*.safetensors

# Ignore the dedicated models directory (where the background downloader will save files)
src-tauri/models/*
!src-tauri/models/.gitkeep

# Ignore the embedded LanceDB data directory and SQLite temp files
src-tauri/data/lancedb/
src-tauri/data/*.db
src-tauri/data/*.db-shm
src-tauri/data/*.db-wal

# =========================================
# Environment Variables & Secrets
# =========================================
.env
.env.*
!.env.example

# =========================================
# OS & Editor Artifacts
# =========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# =========================================
# General Logs & Build Artifacts
# =========================================
*.log
coverage/
.nyc_output/